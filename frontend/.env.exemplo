# Copie este arquivo para ".env" (o .env NÃO vai para o Git).
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Endereço da API em Node (FatoBot e Verificar).
# Local: http://localhost:3000/api (com o backend rodando em outro terminal)
# Na Vercel: a URL do projeto do backend, ex.: https://fato-real-api.vercel.app/api
#   (e no backend, CORS_ORIGIN = URL deste site)
API_URL=http://localhost:3000/api
