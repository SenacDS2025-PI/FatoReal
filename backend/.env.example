# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

PORT=3000

# Endereço(s) do frontend que podem chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:4200

# Supabase (Project Settings > API)
# URL e chave pública (anon): a API lê a tabela politicos. Pode ir na Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave service_role: SÓ para "npm run importar" no seu computador.
# NUNCA coloque na Vercel, no Angular ou no GitHub (ela ignora as regras de segurança).
SUPABASE_SERVICE_ROLE_KEY=

# FatoBot — chave da API do Gemini (https://aistudio.google.com/apikey)
# Sem chave, o FatoBot funciona no modo "somente_fontes" (sem IA).
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=
# Opcional: modelo reserva, usado quando o principal estiver sobrecarregado (503/429).
# Veja os nomes disponíveis no README (seção "Configurar o Gemini").
GEMINI_MODEL_RESERVA=gemini-2.5-flash-lite

# Limites de uso (opcional; padrões no README → "Limites de uso")
LIMITE_POR_IP_MIN=
LIMITE_IA_POR_MIN=
LIMITE_IA_POR_DIA=

# Log do Fato ou Fake (/api/verificar) no console do servidor. Ligado por padrão; 0 desliga.
LOG_VERIFICAR=

# Botão de WhatsApp: número de atendimento com código do país e DDD, só números.
# Ex.: 5561999999999 (use um número do grupo combinado com o coordenador)
WHATSAPP_NUMERO=

# ---------------------------------------------------------------------------
# Área do Gustavo (autenticação, conta e admin). Variáveis novas dessa área
# entram SÓ neste bloco, para não dar conflito com o resto do arquivo.
# A API valida o login com SUPABASE_URL e SUPABASE_ANON_KEY (acima): não precisa
# de chave nova. NUNCA usar a service_role na API.
# ---------------------------------------------------------------------------
