# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

PORT=3000

# Endereço(s) do frontend que podem chamar a API (separe por vírgula)
# Na Vercel, coloque a URL do site, ex.: https://fato-real.vercel.app
CORS_ORIGIN=http://localhost:4200

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA do FatoBot (Claude, da Anthropic): gere a chave em https://platform.claude.com
# Sem chave, o FatoBot funciona no modo "somente fontes" (sem IA).
ANTHROPIC_API_KEY=

# Opcionais (veja a tabela em backend/README.md)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# LIMITE_IA_POR_IP=30
