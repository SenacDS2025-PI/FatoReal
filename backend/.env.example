# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

PORT=3000

# Endereço(s) do frontend que podem chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:4200

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# FatoBot — chave da API do Gemini (https://aistudio.google.com/apikey)
# Sem chave, o FatoBot funciona no modo "somente_fontes" (sem IA).
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.8-flash)
GEMINI_MODEL=
